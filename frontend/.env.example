# Clarify Frontend Environment
# Copy this to .env and fill in values before running.

# URL of the Python backend (server_api.py).
# Local mode: leave as default.
# Remote mode: set to your RTX 5060 PC's IP e.g. http://192.168.1.42:8000
PYTHON_BACKEND_URL=http://localhost:8000

# Node environment
NODE_ENV=development
